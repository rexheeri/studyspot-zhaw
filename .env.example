# MongoDB Atlas – Datenbank-Verbindung (Spots, Reviews, Checkins)
MONGODB_URI=mongodb+srv://<user>:<passwort>@<cluster>.mongodb.net/studyspot?retryWrites=true&w=majority&appName=Cluster0

# Supabase – Authentifizierung (Login/Registrierung mit ZHAW-Mail)
PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-public-key>
# Admin-Account: darf Spots bearbeiten/löschen und Status ohne Rate-Limit melden
ADMIN_EMAIL=<deine-zhaw-mail>

# Mapbox – Public-Token für die Karten-Darstellung (GL JS)
PUBLIC_MAPBOX_TOKEN=pk.<mapbox-public-token>